        $label.Width = 170
        $label.Height = 18
        $label.Text = "ShinySlack  $countText"
        $label.ForeColor = [Drawing.Color]::WhiteSmoke
        $label.Font = New-Object Drawing.Font(
            'Segoe UI',
            9.5,
            [Drawing.FontStyle]::Bold
        )

        $plus = New-Button '+' 28
        $plus.Left = 206
        $plus.Top = 6
        $plus.Height = 24
        Set-RoundedRegion $plus 10

        $plus.Add_Click({
            $now = Get-Date

            foreach($a in @($script:Alerts)){
                if(!$a.ExpireAt){ continue }

                $pauseFrom = $script:TuckStarted

                if(
                    $a.AddedAt -and
                    $a.AddedAt -gt $pauseFrom
                ){
                    $pauseFrom = $a.AddedAt
                }

                if($pauseFrom){
                    $a.ExpireAt =
                        $a.ExpireAt.Add(
                            $now - $pauseFrom
                        )
                }
            }

            $script:Tucked = $false
            $script:TuckStarted = $null
            Render-Expanded
        })

        $bar.Controls.Add($label)
        $bar.Controls.Add($plus)

        $form.Controls.Add($bar)

        Set-RoundedRegion $bar 12
        Position-Form

        if(!$form.Visible){
            $form.Show()
        }
    }
    finally {
        $form.ResumeLayout($true)
    }
}

function Render-Expanded {
    $form.SuspendLayout()

    try {
        $form.Controls.Clear()
        $form.AutoScroll = $true
        $form.Width = 390

        $items = @(
            $script:Alerts |
            Sort-Object AddedAt -Descending
        )

        if($items.Count -eq 0){
            $form.Hide()
            return
        }

        # ONE minus controls the entire stack.
        $header = New-Object System.Windows.Forms.Panel
        $header.Left = 0
        $header.Top = 0
        $header.Width = 390
        $header.Height = 38
        $header.BackColor = [Drawing.Color]::FromArgb(25,28,34)

        $title = New-Object System.Windows.Forms.Label
        $title.Left = 12
        $title.Top = 10
        $title.Width = 310
        $title.Height = 20
        $title.Text = "ShinySlack · $($items.Count) alerts"
        $title.ForeColor = [Drawing.Color]::Gainsboro
        $title.Font = New-Object Drawing.Font(
            'Segoe UI',
            9,
            [Drawing.FontStyle]::Bold
        )

        $minus = New-Button '-' 32
        $minus.Left = 350
        $minus.Top = 7

        $minus.Add_Click({
            $script:Tucked = $true
            $script:TuckStarted = Get-Date
            Render-Tucked
        })

        $header.Controls.Add($title)
        $header.Controls.Add($minus)
        $form.Controls.Add($header)

        $top = 44

        foreach($a in $items){
            $accent = Get-Accent $a.EventKey

            $card = New-Object System.Windows.Forms.Panel
            $card.Left = 0
            $card.Top = $top
            $card.Width = 390
            $card.Height = 78
            $card.BackColor = [Drawing.Color]::FromArgb(30,33,40)
            $card.BorderStyle = 'FixedSingle'

            $stripe = New-Object System.Windows.Forms.Panel
            $stripe.Left = 0
            $stripe.Top = 0
            $stripe.Width = 4
            $stripe.Height = 78
            $stripe.BackColor = $accent

            $channel = New-Object System.Windows.Forms.Label
            $channel.Left = 14
            $channel.Top = 10
            $channel.Width = 245
            $channel.Height = 22
            $channel.Text = $a.Channel
            $channel.ForeColor = $accent
            $channel.Font = New-Object Drawing.Font(
                'Segoe UI',
                10,
                [Drawing.FontStyle]::Bold
            )

            $time = New-Object System.Windows.Forms.Label
            $time.Left = 260
            $time.Top = 10
            $time.Width = 82
            $time.Height = 22
            $time.TextAlign = 'MiddleRight'
            $time.Text = $a.Time.ToString('h:mm tt')
            $time.ForeColor = $accent
            $time.Font = New-Object Drawing.Font('Segoe UI',8.5)

            # X belongs to the individual card.
            $x = New-Button 'X' 28
            $x.Left = 352
            $x.Top = 5
            $x.Tag = $a.Id

            $x.Add_Click({
                param($sender,$eventArgs)

                $id = [int]$sender.Tag

                $target = @(
                    $script:Alerts |
                    Where-Object { $_.Id -eq $id }
                ) | Select-Object -First 1

                if($target){
                    [void]$script:Alerts.Remove($target)
                }

                Render-Expanded
            })

            $sound = New-Object System.Windows.Forms.Label
            $sound.Left = 14
            $sound.Top = 43
            $sound.Width = 355
            $sound.Height = 22
            $sound.Text = "Sound: $($a.Sound)"
            $sound.ForeColor = [Drawing.Color]::Silver
            $sound.Font = New-Object Drawing.Font('Segoe UI',8.5)

            $card.Controls.Add($stripe)
            $card.Controls.Add($channel)
            $card.Controls.Add($time)
            $card.Controls.Add($x)
            $card.Controls.Add($sound)

            $form.Controls.Add($card)

            $top += 82
        }

        $form.Height = [Math]::Min($top + 4,650)

        Position-Form

        if(!$form.Visible){
            $form.Show()
        }
    }
    finally {
        $form.ResumeLayout($true)
    }
}

function Render {
    if($script:Tucked){
        Render-Tucked
    }
    else {
        Render-Expanded
    }
}

function Add-Alert {
    param([string]$Line)

    if(
        $Line -notmatch
        '^(?<stamp>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}) (?<kind>ROUTED|DEFAULT|STACK_EXTRA|STACK_EXTRA_DEFAULT) channel=(?<channel>\S+) sound=(?<sound>.+?) backend=(?<backend>\S+)$'
    ){
        return
    }

    try {
        $stamp = [datetime]::ParseExact(
            $Matches.stamp,
            'yyyy-MM-dd HH:mm:ss.fff',
            [Globalization.CultureInfo]::InvariantCulture
        )
    }
    catch {
        $stamp = Get-Date
    }

    $now = Get-Date

    $obj = [pscustomobject]@{
        Id       = $script:NextId
        Time     = $stamp
        AddedAt  = $now
        Channel  = [string]$Matches.channel
        Sound    = [string]$Matches.sound
        EventKey = $Line
        ExpireAt = $now.AddSeconds($script:AutoDismissSeconds)
    }

    $script:NextId++

    [void]$script:Alerts.Add($obj)

    while($script:Alerts.Count -gt 30){
        $old = $script:Alerts |
            Sort-Object AddedAt |
            Select-Object -First 1

        [void]$script:Alerts.Remove($old)
    }

    Render
}

function Read-NewLines {
    if(!(Test-Path $log)){ return }

    try {
        $stream = New-Object IO.FileStream(
            $log,
            [IO.FileMode]::Open,
            [IO.FileAccess]::Read,
            [IO.FileShare]::ReadWrite
        )

        try {
            if($stream.Length -lt $script:Offset){
                $script:Offset = $stream.Length
                $script:Carry = ''
                return
            }

            if($stream.Length -eq $script:Offset){
                return
            }

            [void]$stream.Seek(
                $script:Offset,
                [IO.SeekOrigin]::Begin
            )

            $reader = New-Object IO.StreamReader(
                $stream,
                [Text.Encoding]::UTF8
            )

            try {
                $text = $reader.ReadToEnd()
                $script:Offset = $stream.Position
            }
            finally {
                $reader.Dispose()
            }
        }
        finally {
            $stream.Dispose()
        }

        if(!$text){ return }

        $combined = $script:Carry + $text
        $parts = $combined -split "`r?`n"

        if($combined.EndsWith("`n")){
            $script:Carry = ''
            $complete = $parts
        }
        else {
            $script:Carry = $parts[-1]

            if($parts.Count -gt 1){
                $complete = $parts[0..($parts.Count - 2)]
            }
            else {
                $complete = @()
            }
        }

        foreach($line in @($complete)){
            if(![string]::IsNullOrWhiteSpace($line)){
                Add-Alert $line.Trim()
            }
        }
    }
    catch {
        # Overlay failure must never affect audio/router.
    }
}

$timer = New-Object System.Windows.Forms.Timer
$timer.Interval = 250

$timer.Add_Tick({
    Read-Settings
    Read-NewLines

    # Tucked = countdown frozen.
    if($script:Tucked){ return }
    if(!$script:AutoDismiss){ return }

    $now = Get-Date

    $expired = @(
        $script:Alerts |
        Where-Object {
            $_.ExpireAt -and
            $_.ExpireAt -le $now
        }
    )

    if($expired.Count){
        foreach($a in $expired){
            [void]$script:Alerts.Remove($a)
        }

        Render-Expanded
    }
})

$timer.Start()

