$ErrorActionPreference = 'Stop'

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$root = Join-Path $env:LOCALAPPDATA 'ShinySlack'
$log  = Join-Path $root 'channel-router.log'
$settingsFile = Join-Path $root 'persistent-alerts.settings.json'

$created = $false
$mutex = New-Object System.Threading.Mutex(
    $true,
    'Local\ShinySlackPersistentAlertsV6',
    [ref]$created
)

if(!$created){ exit }

$script:Alerts = New-Object System.Collections.ArrayList
$script:NextId = 1
$script:Tucked = $false
$script:TuckStarted = $null
$script:Carry = ''
$script:Offset = 0L
$script:AutoDismiss = $true
$script:AutoDismissSeconds = 15
$script:LastSettingsRead = [datetime]::MinValue

$script:Palette = @(
    '#55d8ff',
    '#ff5cc8',
    '#63e6a3',
    '#ffc857',
    '#a78bfa',
    '#5ea1ff',
    '#ff7b72',
    '#b5e853',
    '#ff8fab',
    '#44d7c4'
)

if(Test-Path $log) {
    try {
        $script:Offset = (Get-Item $log).Length
    } catch {}
}

if(!(Test-Path $settingsFile)) {
    [pscustomobject]@{
        autoDismiss = $true
        autoDismissSeconds = 15
    } |
    ConvertTo-Json -Compress |
    Set-Content $settingsFile -Encoding UTF8
}

function Read-Settings {
    if(((Get-Date) - $script:LastSettingsRead).TotalMilliseconds -lt 1500){
        return
    }

    $script:LastSettingsRead = Get-Date

    try {
        $s = Get-Content $settingsFile -Raw -Encoding UTF8 | ConvertFrom-Json

        if($null -ne $s.autoDismiss){
            $script:AutoDismiss = [bool]$s.autoDismiss
        }

        if($s.autoDismissSeconds){
            $script:AutoDismissSeconds =
                [Math]::Max(1,[int]$s.autoDismissSeconds)
        }
    } catch {}
}

function Get-Accent {
    param([string]$Key)

    [uint64]$hash = 0

    foreach($ch in $Key.ToCharArray()){
        $hash = (($hash * 31) + [int][char]$ch) % 4294967296
    }

    $hex = $script:Palette[
        [int]($hash % $script:Palette.Count)
    ]

    [Drawing.ColorTranslator]::FromHtml($hex)
}

function New-Button {
    param(
        [string]$Text,
        [int]$Width = 28
    )

    $b = New-Object System.Windows.Forms.Button
    $b.Text = $Text
    $b.Width = $Width
    $b.Height = 25
    $b.FlatStyle = 'Flat'
    $b.FlatAppearance.BorderSize = 0
    $b.BackColor = [Drawing.Color]::FromArgb(36,39,47)
    $b.ForeColor = [Drawing.Color]::Gainsboro
    $b.Font = New-Object Drawing.Font('Segoe UI',10,[Drawing.FontStyle]::Bold)
    $b.Cursor = [System.Windows.Forms.Cursors]::Hand
    $b
}

$form = New-Object System.Windows.Forms.Form
$form.FormBorderStyle = 'None'
$form.ShowInTaskbar = $false
$form.TopMost = $true
$form.StartPosition = 'Manual'
$form.BackColor = [Drawing.Color]::FromArgb(20,22,27)
$form.ForeColor = [Drawing.Color]::White
$form.Width = 390
$form.Height = 100
$form.Opacity = .97
$form.AutoScroll = $true

function Position-Form {
    $wa = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea

    $form.Left =
        $wa.Left + 12

    $form.Top =
        $wa.Bottom -
        $form.Height -
        12
}

function Render-Tucked {
    $form.SuspendLayout()

    try {
        $form.Controls.Clear()
        $form.AutoScroll = $false

        $form.Width = 230
        $form.Height = 34

        $bar = New-Object System.Windows.Forms.Panel
        $bar.Dock = 'Fill'
        $bar.BackColor = [Drawing.Color]::FromArgb(24,27,33)

        $count = $script:Alerts.Count

        if($count -eq 1){
            $countText = '1 alert'
        }
        else {
            $countText = "$count alerts"
        }

        $label = New-Object System.Windows.Forms.Label
        $label.Left = 12
        $label.Top = 8
        $label.Width = 172
        $label.Height = 18
        $label.Text = "ShinySlack   $countText"
        $label.ForeColor = [Drawing.Color]::Gainsboro
        $label.Font = New-Object Drawing.Font(
            'Segoe UI',
            9,
            [Drawing.FontStyle]::Bold
        )

        $plus = New-Button '+' 28
        $plus.Left = 194
        $plus.Top = 5
        $plus.Height = 24

        $plus.Add_Click({
            $now = Get-Date

            foreach($a in @($script:Alerts)){
                if(!$a.ExpireAt){ continue }

                $pauseFrom = $script:TuckStarted

                if(
                    $a.AddedAt -and
                    $a.AddedAt -gt $pauseFrom
                ){
                    $pauseFrom = $a.AddedAt
                }

                if($pauseFrom){
                    $a.ExpireAt =
                        $a.ExpireAt.Add(
                            $now - $pauseFrom
                        )
                }
            }

            $script:Tucked = $false
            $script:TuckStarted = $null

            Render-Expanded
        })

        $bar.Controls.Add($label)
        $bar.Controls.Add($plus)
        $form.Controls.Add($bar)

        Position-Form

        if(!$form.Visible){
            $form.Show()
        }
    }
    finally {
        $form.ResumeLayout($true)
    }
}

# SHINY-SLACK-DESKTOP-JUMP-V1

function Convert-ToSendKeysLiteral {
    param([string]$Text)

    $sb =
        New-Object Text.StringBuilder

    foreach($ch in $Text.ToCharArray()){

        switch($ch){

            '+' {
                [void]$sb.Append('{+}')
            }

            '^' {
                [void]$sb.Append('{^}')
            }

            '%' {
                [void]$sb.Append('{%}')
            }

            '~' {
                [void]$sb.Append('{~}')
            }

            '(' {
                [void]$sb.Append('{(}')
            }

            ')' {
                [void]$sb.Append('{)}')
            }

            '{' {
                [void]$sb.Append('{{}')
            }

            '}' {
                [void]$sb.Append('{}}')
            }

            default {
                [void]$sb.Append($ch)
            }
        }
    }

    return $sb.ToString()
}


function Open-SlackConversation {
    param([string]$Channel)

    try {

        $target =
            $Channel.Trim()

        if(
            [string]::IsNullOrWhiteSpace(
                $target
            )
        ){
            return
        }


        # Remove visual # before Quick Switcher search.
        if($target.StartsWith('#')){
            $target =
                $target.Substring(1)
        }


        # Find Slack's real desktop window.
        $slack =
            @(
                Get-Process slack `
                    -ErrorAction SilentlyContinue |
                Where-Object {
                    $_.MainWindowHandle -ne 0
                } |
                Sort-Object StartTime
            ) |
            Select-Object -First 1


        if(!$slack){
            return
        }


        $shell =
            New-Object -ComObject WScript.Shell


        # Bring Slack desktop to foreground.
        $activated =
            $shell.AppActivate(
                $slack.Id
            )


        if(!$activated){
            return
        }


        Start-Sleep -Milliseconds 150


        # Slack: Jump to a conversation.
        [System.Windows.Forms.SendKeys]::SendWait(
            '^k'
        )


        Start-Sleep -Milliseconds 180


        $literalTarget =
            Convert-ToSendKeysLiteral `
                $target


        [System.Windows.Forms.SendKeys]::SendWait(
            $literalTarget
        )


        Start-Sleep -Milliseconds 250


        [System.Windows.Forms.SendKeys]::SendWait(
            '{ENTER}'
        )
    }
    catch {
        # Navigation failure must never affect the overlay/audio.
    }
}

function Set-RoundedRegion {
    param(
        $Control,
        [int]$Radius = 14
    )

    if(
        !$Control -or
        $Control.Width -lt 2 -or
        $Control.Height -lt 2
    ){
        return
    }

    $d = $Radius * 2

    $path =
        New-Object System.Drawing.Drawing2D.GraphicsPath

    $path.StartFigure()
    $path.AddArc(0,0,$d,$d,180,90)
    $path.AddArc($Control.Width-$d,0,$d,$d,270,90)
    $path.AddArc(
        $Control.Width-$d,
        $Control.Height-$d,
        $d,
        $d,
        0,
        90
    )
    $path.AddArc(
        0,
        $Control.Height-$d,
        $d,
        $d,
        90,
        90
    )
    $path.CloseFigure()

    $Control.Region =
        New-Object Drawing.Region($path)
}

function Render-Expanded {
    $form.SuspendLayout()

    try {
        $form.Controls.Clear()
        $form.AutoScroll = $true

        # Same overall width/feel as dashboard Activity cards.
        $form.Width = 410

        $items = @(
            $script:Alerts |
            Sort-Object AddedAt -Descending
        )

        if($items.Count -eq 0){
            $form.Hide()
            return
        }


        # =====================================================
        # GLOBAL STACK HEADER
        # =====================================================

        $header =
            New-Object System.Windows.Forms.Panel

        $header.Left = 0
        $header.Top = 0
        $header.Width = 410
        $header.Height = 32

        $header.BackColor =
            [Drawing.Color]::FromArgb(
                14,
                19,
                27
            )

        Set-RoundedRegion $header 11


        $title =
            New-Object System.Windows.Forms.Label

        $title.Left = 13
        $title.Top = 7
        $title.Width = 100
        $title.Height = 18

        $title.Text = 'ShinySlack'

        $title.ForeColor =
            [Drawing.Color]::FromArgb(
                226,
                232,
                240
            )

        $title.Font =
            New-Object Drawing.Font(
                'Segoe UI',
                9,
                [Drawing.FontStyle]::Bold
            )


        $countText =
            if($items.Count -eq 1){
                '1 alert'
            }
            else {
                "$($items.Count) alerts"
            }


        $count =
            New-Object System.Windows.Forms.Label

        $count.Left = 107
        $count.Top = 8
        $count.Width = 90
        $count.Height = 17

        $count.Text = $countText

        $count.ForeColor =
            [Drawing.Color]::FromArgb(
                115,
                131,
                151
            )

        $count.Font =
            New-Object Drawing.Font(
                'Segoe UI',
                8
            )


        # One minus controls the entire stack.
        $minus =
            New-Button '-' 28

        $minus.Left = 369
        $minus.Top = 4
        $minus.Height = 24

        $minus.BackColor =
            [Drawing.Color]::FromArgb(
                25,
                32,
                43
            )

        $minus.ForeColor =
            [Drawing.Color]::FromArgb(
                203,
                213,
                225
            )

        Set-RoundedRegion $minus 8


        $minus.Add_Click({

            $script:Tucked = $true
            $script:TuckStarted = Get-Date

            Render-Tucked
        })


        $header.Controls.Add($title)
        $header.Controls.Add($count)
        $header.Controls.Add($minus)

        $form.Controls.Add($header)


        # =====================================================
        # DASHBOARD-MATCH ALERT CARDS
        # =====================================================

        $top = 38


        foreach($a in $items){

            $accent =
                Get-Accent $a.EventKey


            # -----------------------------------------------
            # Subtle 1px dashboard-style border shell.
            # -----------------------------------------------

            $shell =
                New-Object System.Windows.Forms.Panel

            $shell.Left = 0
            $shell.Top = $top

            $shell.Width = 410
            $shell.Height = 66

            $shell.BackColor =
                [Drawing.Color]::FromArgb(
                    31,
                    40,
                    53
                )

            Set-RoundedRegion $shell 14


            # -----------------------------------------------
            # Actual near-black Activity card.
            # -----------------------------------------------

            $card =
                New-Object System.Windows.Forms.Panel

            $card.Left = 1
            $card.Top = 1

            $card.Width = 408
            $card.Height = 64

            $card.BackColor =
                [Drawing.Color]::FromArgb(
                    8,
                    13,
                    20
                )

            Set-RoundedRegion $card 13


            # -----------------------------------------------
            # Thin colored Activity rail.
            # -----------------------------------------------

            $rail =
                New-Object System.Windows.Forms.Panel

            $rail.Left = 0
            $rail.Top = 0

            $rail.Width = 4
            $rail.Height = 64

            $rail.BackColor = $accent


            # -----------------------------------------------
            # Channel — same bold accent style.
            # -----------------------------------------------

            $channel =
                New-Object System.Windows.Forms.Label

            $channel.Left = 15
            $channel.Top = 9

            $channel.Width = 245
            $channel.Height = 22

            $channel.Text = $a.Channel
            $channel.ForeColor = $accent

            $channel.Font =
                New-Object Drawing.Font(
                    'Segoe UI',
                    10,
                    [Drawing.FontStyle]::Bold
                )


            # Preserve Slack jump behavior when helper exists.
            if(
                Get-Command `
                    Open-SlackConversation `
                    -ErrorAction SilentlyContinue
            ){

                $channel.Tag = $a.Channel

                $channel.Cursor =
                    [System.Windows.Forms.Cursors]::Hand

                $channel.Add_Click({
                    param($sender,$eventArgs)

                    Open-SlackConversation `
                        -Channel ([string]$sender.Tag)
                })
            }


            # -----------------------------------------------
            # Timestamp — same event accent as dashboard.
            # -----------------------------------------------

            $time =
                New-Object System.Windows.Forms.Label

            $time.Left = 267
            $time.Top = 10

            $time.Width = 88
            $time.Height = 20

            $time.TextAlign = 'MiddleRight'
            $time.Text = $a.Time.ToString('h:mm tt')

            $time.ForeColor = $accent

            $time.Font =
                New-Object Drawing.Font(
                    'Segoe UI',
                    8,
                    [Drawing.FontStyle]::Bold
                )


            # -----------------------------------------------
            # X — small unobtrusive overlay-only control.
            # -----------------------------------------------

            $x =
                New-Button 'X' 28

            $x.Left = 369
            $x.Top = 5
            $x.Height = 24

            $x.Tag = $a.Id

            $x.BackColor =
                [Drawing.Color]::FromArgb(
                    21,
                    28,
                    38
                )

            $x.ForeColor =
                [Drawing.Color]::FromArgb(
                    184,
                    196,
                    211
                )

            Set-RoundedRegion $x 8


            $x.Add_Click({
                param($sender,$eventArgs)

                $id =
                    [int]$sender.Tag

                $target =
                    @(
                        $script:Alerts |
                        Where-Object {
                            $_.Id -eq $id
                        }
                    ) |
                    Select-Object -First 1


                if($target){

                    [void]$script:Alerts.Remove(
                        $target
                    )
                }


                Render-Expanded
            })


            # -----------------------------------------------
            # EXACT dashboard-style metadata line.
            # -----------------------------------------------

            $sound =
                New-Object System.Windows.Forms.Label

            $sound.Left = 15
            $sound.Top = 38

            $sound.Width = 360
            $sound.Height = 18

            $sound.Text =
                "Sound: $($a.Sound)"

            $sound.ForeColor =
                [Drawing.Color]::FromArgb(
                    106,
                    123,
                    146
                )

            $sound.Font =
                New-Object Drawing.Font(
                    'Segoe UI',
                    7.75
                )


            $card.Controls.Add($rail)
            $card.Controls.Add($channel)
            $card.Controls.Add($time)
            $card.Controls.Add($x)
            $card.Controls.Add($sound)

            $shell.Controls.Add($card)

            $form.Controls.Add($shell)


            # Dashboard-like small vertical gap.
            $top += 72
        }


        $form.Height =
            [Math]::Min(
                $top + 2,
                610
            )


        Position-Form


        if(!$form.Visible){
            $form.Show()
        }
    }
    finally {
        $form.ResumeLayout($true)
    }
}

function Render {
    if($script:Tucked){
        Render-Tucked
    }
    else {
        Render-Expanded
    }
}

function Add-Alert {
    param([string]$Line)

    if(
        $Line -notmatch
        '^(?<stamp>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}) (?<kind>ROUTED|DEFAULT|STACK_EXTRA|STACK_EXTRA_DEFAULT) channel=(?<channel>\S+) sound=(?<sound>.+?) backend=(?<backend>\S+)$'
    ){
        return
    }

    try {
        $stamp = [datetime]::ParseExact(
            $Matches.stamp,
            'yyyy-MM-dd HH:mm:ss.fff',
            [Globalization.CultureInfo]::InvariantCulture
        )
    }
    catch {
        $stamp = Get-Date
    }

    $now = Get-Date

    $obj = [pscustomobject]@{
        Id       = $script:NextId
        Time     = $stamp
        AddedAt  = $now
        Channel  = [string]$Matches.channel
        Sound    = [string]$Matches.sound
        EventKey = $Line
        ExpireAt = $now.AddSeconds($script:AutoDismissSeconds)
    }

    $script:NextId++

    [void]$script:Alerts.Add($obj)

    while($script:Alerts.Count -gt 30){
        $old = $script:Alerts |
            Sort-Object AddedAt |
            Select-Object -First 1

        [void]$script:Alerts.Remove($old)
    }

    Render
}

function Read-NewLines {
    if(!(Test-Path $log)){ return }

    try {
        $stream = New-Object IO.FileStream(
            $log,
            [IO.FileMode]::Open,
            [IO.FileAccess]::Read,
            [IO.FileShare]::ReadWrite
        )

        try {
            if($stream.Length -lt $script:Offset){
                $script:Offset = $stream.Length
                $script:Carry = ''
                return
            }

            if($stream.Length -eq $script:Offset){
                return
            }

            [void]$stream.Seek(
                $script:Offset,
                [IO.SeekOrigin]::Begin
            )

            $reader = New-Object IO.StreamReader(
                $stream,
                [Text.Encoding]::UTF8
            )

            try {
                $text = $reader.ReadToEnd()
                $script:Offset = $stream.Position
            }
            finally {
                $reader.Dispose()
            }
        }
        finally {
            $stream.Dispose()
        }

        if(!$text){ return }

        $combined = $script:Carry + $text
        $parts = $combined -split "`r?`n"

        if($combined.EndsWith("`n")){
            $script:Carry = ''
            $complete = $parts
        }
        else {
            $script:Carry = $parts[-1]

            if($parts.Count -gt 1){
                $complete = $parts[0..($parts.Count - 2)]
            }
            else {
                $complete = @()
            }
        }

        foreach($line in @($complete)){
            if(![string]::IsNullOrWhiteSpace($line)){
                Add-Alert $line.Trim()
            }
        }
    }
    catch {
        # Overlay failure must never affect audio/router.
    }
}

$timer = New-Object System.Windows.Forms.Timer
$timer.Interval = 250

$timer.Add_Tick({
    Read-Settings
    Read-NewLines

    # Tucked = countdown frozen.
    if($script:Tucked){ return }
    if(!$script:AutoDismiss){ return }

    $now = Get-Date

    $expired = @(
        $script:Alerts |
        Where-Object {
            $_.ExpireAt -and
            $_.ExpireAt -le $now
        }
    )

    if($expired.Count){
        foreach($a in $expired){
            [void]$script:Alerts.Remove($a)
        }

        Render-Expanded
    }
})

$timer.Start()

# Message loop stays alive even while no alert is visible.
[System.Windows.Forms.Application]::Run().Id -eq $id
                    }
                ) |
                Select-Object -First 1

                if($target){
                    [void]$script:Alerts.Remove($target)
                }

                Render-Expanded
            })

            $sound = New-Object System.Windows.Forms.Label
            $sound.Left = 15
            $sound.Top = 40
            $sound.Width = 355
            $sound.Height = 20
            $sound.Text = "Sound: $($a.Sound)"
            $sound.ForeColor = [Drawing.Color]::FromArgb(145,155,170)
            $sound.Font = New-Object Drawing.Font(
                'Segoe UI',
                8.25
            )

            $card.Controls.Add($stripe)
            $card.Controls.Add($channel)
            $card.Controls.Add($time)
            $card.Controls.Add($x)
            $card.Controls.Add($sound)
            $card.Controls.Add($divider)

            $form.Controls.Add($card)

            $top += 76
        }

        $form.Height =
            [Math]::Min(
                $top + 2,
                610
            )

        Position-Form

        if(!$form.Visible){
            $form.Show()
        }
    }
    finally {
        $form.ResumeLayout($true)
    }
}

function Render {
    if($script:Tucked){
        Render-Tucked
    }
    else {
        Render-Expanded
    }
}

